{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "main-site": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "installCommand": "npm install"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "main-site"
      }
    }
  ]
}
